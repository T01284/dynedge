# ESP32-P4 (Tab5): CMD console on Grove UART — TX=GPIO54, RX=GPIO53 @115200.
# Flash still via USB (COM15); power bench: USB-TTL + external 5V + P5S1.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART_NUM=1
CONFIG_ESP_CONSOLE_UART_TX_GPIO=54
CONFIG_ESP_CONSOLE_UART_RX_GPIO=53
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Tab5 / EV board pre-rev3 memory map (matches platform board "ES pre rev.300")
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
